# Copy to .env and fill in. .env is gitignored.
# Everything here is a secret; everything in config.yaml is a preference.

# --- Job sources -----------------------------------------------------------
# Adzuna: free tier, register at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Reed: free, request at https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=

# --- Notifications ---------------------------------------------------------
# Pick an unguessable topic, then subscribe to the same string in the ntfy app.
# Anyone who knows it can read your notifications, so use something random:
#   python -c "import secrets; print('jobs-' + secrets.token_urlsafe(16))"
JOBHUNT_NTFY_TOPIC=

# --- Cover letters (optional) ----------------------------------------------
# Without this, letters come from the template drafter instead.
ANTHROPIC_API_KEY=

# --- Company research (optional) -------------------------------------------
# Free key: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=
